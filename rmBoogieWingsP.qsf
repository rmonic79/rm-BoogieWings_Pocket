set_global_assignment -name SYSTEMVERILOG_FILE sys/hps_io.sv
set_global_assignment -name SEARCH_PATH pocket
set_global_assignment -name VERILOG_FILE pocket/pll_0002.v
set_global_assignment -name QIP_FILE pocket/pll_0002.qip
set_global_assignment -name VERILOG_MACRO "POCKET_VID_W=320"
set_global_assignment -name VERILOG_MACRO "POCKET_VID_H=240"
set_global_assignment -name VERILOG_MACRO "POCKET_SLOT_QT=0"
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/deco56_ioctl_decrypt_reg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/auto_save_adaptor_1buf.sv
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF

